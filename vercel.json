{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd 05-frontend && npm ci --no-audit --no-fund",
  "buildCommand": "cd 05-frontend && npm run build",
  "outputDirectory": "05-frontend/dist",
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{03-backend/app/**,02-database/queries/**,02-database/demos/**}",
      "excludeFiles": "{05-frontend/**,01-dataset/**,06-docs/**,04-cli/**,scripts/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
