digraph ER { graph [rankdir=LR, bgcolor="white", nodesep=0.5, ranksep=1.1, fontname="Helvetica", pad=0.3, splines=true];
node [fontname="Helvetica", fontsize=10]; edge [color="#5B6C8F", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.2];
subgraph "cluster_GEOGRAPHY" { label=<<B>GEOGRAPHY</B>>; fontcolor="#1F6F6B"; color="#DDD0BB"; style="rounded,dashed";
"states" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#1F6F6B"><FONT COLOR="white"><B>states</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="state_code"><FONT COLOR="#C4472B"><B>PK state_code</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">character(2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="state_name"><FONT COLOR="#1E2233">UQ state_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="region"><FONT COLOR="#1E2233">region</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">region_t</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_union_territory"><FONT COLOR="#1E2233">is_union_territory</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">boolean</FONT></TD></TR></TABLE>> shape=plain];
"cities" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#1F6F6B"><FONT COLOR="white"><B>cities</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="city_id"><FONT COLOR="#C4472B"><B>PK city_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="city_name"><FONT COLOR="#1E2233">UQ city_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="state_code"><FONT COLOR="#1E2233">FK UQ state_code</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">character(2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="latitude"><FONT COLOR="#1E2233">latitude</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">lat_deg</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="longitude"><FONT COLOR="#1E2233">longitude</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">lon_deg</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_metro"><FONT COLOR="#1E2233">is_metro</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tier"><FONT COLOR="#1E2233">tier</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">smallint</FONT></TD></TR></TABLE>> shape=plain];
"landmarks" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#1F6F6B"><FONT COLOR="white"><B>landmarks</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="landmark_id"><FONT COLOR="#C4472B"><B>PK landmark_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="city_id"><FONT COLOR="#1E2233">FK UQ city_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="landmark_name"><FONT COLOR="#1E2233">UQ landmark_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category"><FONT COLOR="#1E2233">category</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">landmark_category_t</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="latitude"><FONT COLOR="#1E2233">latitude</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">lat_deg</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="longitude"><FONT COLOR="#1E2233">longitude</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">lon_deg</FONT></TD></TR></TABLE>> shape=plain];
}
subgraph "cluster_PROPERTY" { label=<<B>PROPERTY</B>>; fontcolor="#C4472B"; color="#DDD0BB"; style="rounded,dashed";
"hotels" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#C4472B"><FONT COLOR="white"><B>hotels</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hotel_id"><FONT COLOR="#C4472B"><B>PK hotel_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_ref"><FONT COLOR="#1E2233">UQ source_ref</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source"><FONT COLOR="#1E2233">source</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">listing_source_t</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hotel_name"><FONT COLOR="#1E2233">hotel_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="property_type"><FONT COLOR="#1E2233">property_type</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">property_type_t</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="star_rating"><FONT COLOR="#1E2233">star_rating</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="city_id"><FONT COLOR="#1E2233">FK city_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="locality"><FONT COLOR="#1E2233">locality</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="address"><FONT COLOR="#1E2233">address</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(400)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="latitude"><FONT COLOR="#1E2233">latitude</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">lat_deg</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="longitude"><FONT COLOR="#1E2233">longitude</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">lon_deg</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tagline"><FONT COLOR="#1E2233">tagline</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(160)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="description"><FONT COLOR="#1E2233">description</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="check_in_time"><FONT COLOR="#1E2233">check_in_time</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">time without time zone</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="check_out_time"><FONT COLOR="#1E2233">check_out_time</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">time without time zone</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_signature"><FONT COLOR="#1E2233">is_signature</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="avg_rating"><FONT COLOR="#1E2233">avg_rating</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">numeric(2,1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="review_count"><FONT COLOR="#1E2233">review_count</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="search_doc"><FONT COLOR="#1E2233">search_doc</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">tsvector (generated)</FONT></TD></TR></TABLE>> shape=plain];
"hotel_landmarks" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#C4472B"><FONT COLOR="white"><B>hotel_landmarks</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hotel_id"><FONT COLOR="#C4472B"><B>PK FK hotel_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="landmark_id"><FONT COLOR="#C4472B"><B>PK FK landmark_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="distance_km"><FONT COLOR="#1E2233">distance_km</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">numeric(5,2)</FONT></TD></TR></TABLE>> shape=plain];
"amenities" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#C4472B"><FONT COLOR="white"><B>amenities</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amenity_id"><FONT COLOR="#C4472B"><B>PK amenity_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amenity_name"><FONT COLOR="#1E2233">UQ amenity_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category"><FONT COLOR="#1E2233">category</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">amenity_category_t</FONT></TD></TR></TABLE>> shape=plain];
"hotel_amenities" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#C4472B"><FONT COLOR="white"><B>hotel_amenities</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hotel_id"><FONT COLOR="#C4472B"><B>PK FK hotel_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amenity_id"><FONT COLOR="#C4472B"><B>PK FK amenity_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">smallint</FONT></TD></TR></TABLE>> shape=plain];
}
subgraph "cluster_INVENTORY" { label=<<B>INVENTORY</B>>; fontcolor="#E3A72F"; color="#DDD0BB"; style="rounded,dashed";
"room_types" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#E3A72F"><FONT COLOR="white"><B>room_types</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="room_type_id"><FONT COLOR="#C4472B"><B>PK room_type_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hotel_id"><FONT COLOR="#1E2233">FK UQ hotel_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="type_name"><FONT COLOR="#1E2233">UQ type_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="bed_type"><FONT COLOR="#1E2233">bed_type</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">bed_type_t</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="max_adults"><FONT COLOR="#1E2233">max_adults</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="max_children"><FONT COLOR="#1E2233">max_children</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="area_sqft"><FONT COLOR="#1E2233">area_sqft</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="base_price"><FONT COLOR="#1E2233">base_price</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">rupees</FONT></TD></TR></TABLE>> shape=plain];
"rooms" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#E3A72F"><FONT COLOR="white"><B>rooms</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="room_id"><FONT COLOR="#C4472B"><B>PK room_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="hotel_id"><FONT COLOR="#1E2233">FK UQ hotel_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="room_number"><FONT COLOR="#1E2233">UQ room_number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(8)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="room_type_id"><FONT COLOR="#1E2233">FK room_type_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="floor_no"><FONT COLOR="#1E2233">floor_no</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active"><FONT COLOR="#1E2233">is_active</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">boolean</FONT></TD></TR></TABLE>> shape=plain];
"seasons" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#E3A72F"><FONT COLOR="white"><B>seasons</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_id"><FONT COLOR="#C4472B"><B>PK season_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="season_name"><FONT COLOR="#1E2233">UQ season_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="start_date"><FONT COLOR="#1E2233">start_date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="end_date"><FONT COLOR="#1E2233">end_date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="multiplier"><FONT COLOR="#1E2233">multiplier</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">numeric(3,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="notes"><FONT COLOR="#1E2233">notes</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(120)</FONT></TD></TR></TABLE>> shape=plain];
}
subgraph "cluster_CUSTOMER" { label=<<B>CUSTOMER</B>>; fontcolor="#5B6C8F"; color="#DDD0BB"; style="rounded,dashed";
"guests" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#5B6C8F"><FONT COLOR="white"><B>guests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="guest_id"><FONT COLOR="#C4472B"><B>PK guest_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="first_name"><FONT COLOR="#1E2233">first_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_name"><FONT COLOR="#1E2233">last_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(40)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="phone"><FONT COLOR="#1E2233">UQ phone</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">indian_mobile</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email"><FONT COLOR="#1E2233">UQ email</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">email_address</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_of_birth"><FONT COLOR="#1E2233">date_of_birth</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_type"><FONT COLOR="#1E2233">UQ id_type</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">id_document_t</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_number"><FONT COLOR="#1E2233">UQ id_number</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="home_city_id"><FONT COLOR="#1E2233">FK home_city_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="referred_by"><FONT COLOR="#1E2233">FK referred_by</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#1E2233">created_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">timestamp with time zone</FONT></TD></TR></TABLE>> shape=plain];
}
subgraph "cluster_BOOKING" { label=<<B>BOOKING</B>>; fontcolor="#1E2233"; color="#DDD0BB"; style="rounded,dashed";
