_at"><FONT COLOR="#1E2233">cancelled_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">timestamp with time zone</FONT></TD></TR></TABLE>> shape=plain];
"booking_rooms" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#1E2233"><FONT COLOR="white"><B>booking_rooms</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="booking_id"><FONT COLOR="#C4472B"><B>PK FK booking_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="room_id"><FONT COLOR="#C4472B"><B>PK FK room_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="room_subtotal"><FONT COLOR="#1E2233">room_subtotal</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">rupees</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="room_tax"><FONT COLOR="#1E2233">room_tax</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">rupees</FONT></TD></TR></TABLE>> shape=plain];
"payments" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#1E2233"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="payment_id"><FONT COLOR="#C4472B"><B>PK payment_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="booking_id"><FONT COLOR="#1E2233">FK booking_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="kind"><FONT COLOR="#1E2233">kind</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">payment_kind_t</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="method"><FONT COLOR="#1E2233">method</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">payment_method_t</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT COLOR="#1E2233">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">payment_status_t</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="amount"><FONT COLOR="#1E2233">amount</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">rupees</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="upi_vpa"><FONT COLOR="#1E2233">upi_vpa</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="card_last4"><FONT COLOR="#1E2233">card_last4</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">character(4)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="gateway_ref"><FONT COLOR="#1E2233">UQ gateway_ref</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(24)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#1E2233">created_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">timestamp with time zone</FONT></TD></TR></TABLE>> shape=plain];
"reviews" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FBF7F0"><TR><TD COLSPAN="2" BGCOLOR="#1E2233"><FONT COLOR="white"><B>reviews</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="review_id"><FONT COLOR="#C4472B"><B>PK review_id</B></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="booking_id"><FONT COLOR="#1E2233">FK UQ booking_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">integer</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="rating"><FONT COLOR="#1E2233">rating</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">smallint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title"><FONT COLOR="#1E2233">title</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="body"><FONT COLOR="#1E2233">body</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT COLOR="#1E2233">created_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7B7F8F">timestamp with time zone</FONT></TD></TR></TABLE>> shape=plain];
}
"states" -> "cities" [tooltip="cities.state_code → states"];
"cities" -> "landmarks" [tooltip="landmarks.city_id → cities"];
"cities" -> "hotels" [tooltip="hotels.city_id → cities"];
