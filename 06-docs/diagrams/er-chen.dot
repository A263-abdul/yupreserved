graph Chen { graph [layout=neato, overlap=false, sep="+18", splines=true, bgcolor="white", fontname="Helvetica"]; node [fontname="Helvetica"]; edge [color="#1E2233", fontname="Helvetica Bold"];
"STATE" [shape=box, style="filled", fillcolor="#FBF7F0", color="#1E2233", penwidth=1.4, fontname="Helvetica Bold"];
"CITY" [shape=box, style="filled", fillcolor="#FBF7F0", color="#1E2233", penwidth=1.4, fontname="Helvetica Bold"];
"LANDMARK" [shape=box, style="filled", fillcolor="#FBF7F0", color="#1E2233", penwidth=1.4, fontname="Helvetica Bold"];
"HOTEL" [shape=box, style="filled", fillcolor="#FBF7F0", color="#1E2233", penwidth=1.4, fontname="Helvetica Bold"];
"AMENITY" [shape=box, style="filled", fillcolor="#FBF7F0", color="#1E2233", penwidth=1.4, fontname="Helvetica Bold"];
"ROOM_TYPE" [shape=box, style="filled", fillcolor="#FBF7F0", color="#1E2233", penwidth=1.4, fontname="Helvetica Bold"];
"ROOM" [shape=box, peripheries=2, style="filled", fillcolor="#FBF7F0", color="#1E2233", fontname="Helvetica Bold"];
"SEASON" [shape=box, style="filled", fillcolor="#FBF7F0", color="#1E2233", penwidth=1.4, fontname="Helvetica Bold"];
"GUEST" [shape=box, style="filled", fillcolor="#FBF7F0", color="#1E2233", penwidth=1.4, fontname="Helvetica Bold"];
"BOOKING" [shape=box, style="filled", fillcolor="#FBF7F0", color="#1E2233", penwidth=1.4, fontname="Helvetica Bold"];
"PAYMENT" [shape=box, style="filled", fillcolor="#FBF7F0", color="#1E2233", penwidth=1.4, fontname="Helvetica Bold"];
"REVIEW" [shape=box, style="filled", fillcolor="#FBF7F0", color="#1E2233", penwidth=1.4, fontname="Helvetica Bold"];
r0 [label="in_state", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"CITY" -- r0 [label="N", fontsize=10, fontcolor="#C4472B"];
r0 -- "STATE" [label="1", fontsize=10, fontcolor="#C4472B"];
r1 [label="located_in", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"HOTEL" -- r1 [label="N", fontsize=10, fontcolor="#C4472B"];
r1 -- "CITY" [label="1", fontsize=10, fontcolor="#C4472B"];
r2 [label="in_city", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"LANDMARK" -- r2 [label="N", fontsize=10, fontcolor="#C4472B"];
r2 -- "CITY" [label="1", fontsize=10, fontcolor="#C4472B"];
r3 [label="near
(distance_km)", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"HOTEL" -- r3 [label="M", fontsize=10, fontcolor="#C4472B"];
r3 -- "LANDMARK" [label="N", fontsize=10, fontcolor="#C4472B"];
r4 [label="offers", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"HOTEL" -- r4 [label="M", fontsize=10, fontcolor="#C4472B"];
r4 -- "AMENITY" [label="N", fontsize=10, fontcolor="#C4472B"];
r5 [label="sells", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"HOTEL" -- r5 [label="1", fontsize=10, fontcolor="#C4472B"];
r5 -- "ROOM_TYPE" [label="N", fontsize=10, fontcolor="#C4472B"];
r6 [label="has", shape=diamond, peripheries=2, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"HOTEL" -- r6 [label="1", fontsize=10, fontcolor="#C4472B", penwidth=2.2];
r6 -- "ROOM" [label="N", fontsize=10, fontcolor="#C4472B"];
r7 [label="of_type", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"ROOM" -- r7 [label="N", fontsize=10, fontcolor="#C4472B"];
r7 -- "ROOM_TYPE" [label="1", fontsize=10, fontcolor="#C4472B"];
r8 [label="makes", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"GUEST" -- r8 [label="1", fontsize=10, fontcolor="#C4472B"];
r8 -- "BOOKING" [label="N", fontsize=10, fontcolor="#C4472B"];
r9 [label="at", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"BOOKING" -- r9 [label="N", fontsize=10, fontcolor="#C4472B"];
r9 -- "HOTEL" [label="1", fontsize=10, fontcolor="#C4472B"];
r10 [label="holds
(subtotal, tax)", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"BOOKING" -- r10 [label="M", fontsize=10, fontcolor="#C4472B"];
r10 -- "ROOM" [label="N", fontsize=10, fontcolor="#C4472B"];
r11 [label="paid_by", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"BOOKING" -- r11 [label="1", fontsize=10, fontcolor="#C4472B"];
r11 -- "PAYMENT" [label="N", fontsize=10, fontcolor="#C4472B"];
r12 [label="reviewed_in", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"BOOKING" -- r12 [label="1", fontsize=10, fontcolor="#C4472B"];
r12 -- "REVIEW" [label="1", fontsize=10, fontcolor="#C4472B"];
r13 [label="refers", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"GUEST" -- r13 [label="1", fontsize=10, fontcolor="#C4472B"];
r13 -- "GUEST" [label="N", fontsize=10, fontcolor="#C4472B"];
r14 [label="lives_in", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"GUEST" -- r14 [label="N", fontsize=10, fontcolor="#C4472B"];
r14 -- "CITY" [label="1", fontsize=10, fontcolor="#C4472B"];
r15 [label="prices
(theta join on night)", shape=diamond, style="filled", fillcolor="#F3E3C3", color="#1E2233", fontsize=10];
"SEASON" -- r15 [label="1", fontsize=10, fontcolor="#C4472B"];
r15 -- "BOOKING" [label="N", fontsize=10, fontcolor="#C4472B"];
"HOTEL_a0" [label=<<U>hotel_id</U>>, shape=ellipse, color="#5B6C8F", fontsize=9];
"HOTEL" -- "HOTEL_a0" [color="#5B6C8F"];
"HOTEL_a1" [label=<name>, shape=ellipse, color="#5B6C8F", fontsize=9];
"HOTEL" -- "HOTEL_a1" [color="#5B6C8F"];
"HOTEL_a2" [label=<star_rating>, shape=ellipse, color="#5B6C8F", fontsize=9];
"HOTEL" -- "HOTEL_a2" [color="#5B6C8F"];
"HOTEL_a3" [label=<{amenities}*>, shape=ellipse, color="#5B6C8F", fontsize=9, peripheries=2];
"HOTEL" -- "HOTEL_a3" [color="#5B6C8F"];
"HOTEL_a4" [label=<avg_rating (derived)>, shape=ellipse, color="#5B6C8F", fontsize=9, style=dashed];
"HOTEL" -- "HOTEL_a4" [color="#5B6C8F"];
"GUEST_a0" [label=<<U>guest_id</U>>, shape=ellipse, color="#5B6C8F", fontsize=9];
"GUEST" -- "GUEST_a0" [color="#5B6C8F"];
"GUEST_a1" [label=<name (first, last)>, shape=ellipse, color="#5B6C8F", fontsize=9];
"GUEST" -- "GUEST_a1" [color="#5B6C8F"];
"GUEST_a2" [label=<phone>, shape=ellipse, color="#5B6C8F", fontsize=9];
"GUEST" -- "GUEST_a2" [color="#5B6C8F"];
"GUEST_a3" [label=<email>, shape=ellipse, color="#5B6C8F", fontsize=9];
"GUEST" -- "GUEST_a3" [color="#5B6C8F"];
"GUEST_a4" [label=<age (derived)>, shape=ellipse, color="#5B6C8F", fontsize=9, style=dashed];
"GUEST" -- "GUEST_a4" [color="#5B6C8F"];
"BOOKING_a0" [label=<<U>booking_id</U>>, shape=ellipse, color="#5B6C8F", fontsize=9];
"BOOKING" -- "BOOKING_a0" [color="#5B6C8F"];
"BOOKING_a1" [label=<booking_ref>, shape=ellipse, color="#5B6C8F", fontsize=9];
"BOOKING" -- "BOOKING_a1" [color="#5B6C8F"];
"BOOKING_a2" [label=<check_in>, shape=ellipse, color="#5B6C8F", fontsize=9];
"BOOKING" -- "BOOKING_a2" [color="#5B6C8F"];
"BOOKING_a3" [label=<check_out>, shape=ellipse, color="#5B6C8F", fontsize=9];
"BOOKING" -- "BOOKING_a3" [color="#5B6C8F"];
"BOOKING_a4" [label=<nights (derived)>, shape=ellipse, color="#5B6C8F", fontsize=9, style=dashed];
"BOOKING" -- "BOOKING_a4" [color="#5B6C8F"];
"ROOM_a0" [label=<<U>room_number</U> (partial key)>, shape=ellipse, color="#5B6C8F", fontsize=9];
"ROOM" -- "ROOM_a0" [color="#5B6C8F"];
"ROOM_a1" [label=<floor_no>, shape=ellipse, color="#5B6C8F", fontsize=9];
"ROOM" -- "ROOM_a1" [color="#5B6C8F"];
"SEASON_a0" [label=<<U>season_id</U>>, shape=ellipse, color="#5B6C8F", fontsize=9];
"SEASON" -- "SEASON_a0" [color="#5B6C8F"];
"SEASON_a1" [label=<dates>, shape=ellipse, color="#5B6C8F", fontsize=9];
"SEASON" -- "SEASON_a1" [color="#5B6C8F"];
"SEASON_a2" [label=<multiplier>, shape=ellipse, color="#5B6C8F", fontsize=9];
"SEASON" -- "SEASON_a2" [color="#5B6C8F"];
}